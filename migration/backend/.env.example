# Copy to .env for local development:  cp .env.example .env
#
# .env is git-ignored and must stay that way. Real values belong in the
# platform's secret store, never in this file and never in a commit:
#   - GitHub Actions secrets  -> the scheduled automation jobs
#   - Azure Container App secrets -> the running API
# See docs/SECRETS.md.

APP_ENV=development
LOG_LEVEL=INFO

# Browsers allowed to call this API. Comma separated, no trailing slash.
# In Azure this is set to the Cloudflare Pages production domain.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Preview deployments get one subdomain per commit, so they match a pattern.
ALLOWED_ORIGIN_REGEX=https://[a-z0-9-]+\.bqe-frontend\.pages\.dev

# Upstream and caching
YAHOO_BASE=https://query1.finance.yahoo.com
QUOTE_CACHE_TTL=60
QUOTE_BROWSER_TTL=45
UPSTREAM_TIMEOUT=8

# --- Automation jobs only (not read by the API container) ------------------
# Used by automation/scripts/fetch_market_tape.py. Leave blank locally to run
# the script with --no-results, which needs no key at all.
ANTHROPIC_API_KEY=
